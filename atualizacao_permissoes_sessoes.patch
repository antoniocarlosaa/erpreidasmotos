+                Cancelar
+              </Button>
+              <Button type="submit" disabled={isUpdatingEmployee} className="h-9 text-xs font-semibold">
+                {isUpdatingEmployee && <Loader2 className="mr-2 h-4 w-4 animate-spin" />}
+                Salvar Altera├º├Áes
+              </Button>
+            </DialogFooter>
+          </form>
+        </DialogContent>
+      </Dialog>
     </div>
   );
 }
