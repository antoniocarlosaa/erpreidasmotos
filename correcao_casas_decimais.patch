+const formatToBRLInput = (val: string | number | undefined | null): string => {
+  if (val === undefined || val === null) return "";
+  
+  let cleanValue = "";
+  if (typeof val === "number") {
+    // Convert number to cents representation (e.g. 40000 -> 4000000)
+    cleanValue = val.toFixed(2).replace(/\D/g, "");
+  } else {
+    cleanValue = String(val).replace(/\D/g, "");
+  }
+  
+  if (!cleanValue) return "";
+  const numberValue = parseFloat(cleanValue) / 100;
+  return new Intl.NumberFormat("pt-BR", {
+    style: "currency",
+    currency: "BRL",
+  }).format(numberValue);
+};
